# Guia do Higienizador — Apache / HostGator
# Document root do subdomínio: public_html/guiadohigienizador
# URL: https://guiadohigienizador.autolimpezapro.com.br/
# SPA estático + API PHP em /api (MySQL). Sem Node no servidor.

DirectoryIndex index.html index.php
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # O document root JÁ é public_html/guiadohigienizador.
  # No subdomínio as URLs públicas começam em /  →  RewriteBase /
  # Equivalente correto de “subdiretório no disco, raiz no vhost”.
  # NÃO use /guiadohigienizador/ aqui: o Apache procuraria
  # public_html/guiadohigienizador/guiadohigienizador/... e quebraria o site.
  # Só use RewriteBase /guiadohigienizador/ se o site for servido como pasta
  # do domínio principal (autolimpezapro.com.br/guiadohigienizador/) e o
  # build tiver sido gerado com base Vite correspondente.
  RewriteBase /

  # HTTPS (Let's Encrypt / AutoSSL no cPanel)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Nunca servir o config da API (senhas MySQL / OpenAI).
  RewriteRule ^api/config\.php$ - [F]

  # API PHP: /api e /api/* vão para o front controller.
  RewriteRule ^api(?:/.*)?$ api/index.php [L,QSA]

  # Arquivo ou pasta real: assets hashed, HTML pré-renderizado, etc.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /fichas/slug → pasta/index.html (pré-render no build)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # SPA: rotas só no cliente (F5 em /fichas/$slug, comunidade, auth…)
  # _shell.html é o casco TanStack Start; se não existir, cai no index.html.
  RewriteCond %{DOCUMENT_ROOT}/_shell.html -f
  RewriteRule ^ _shell.html [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# HTML muda a cada deploy — não cachear. JS/CSS hashed em /assets/ — 1 ano.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:js|css|woff2|woff|png|jpe?g|gif|svg|webp|ico|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
