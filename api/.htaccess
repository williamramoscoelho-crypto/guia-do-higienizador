# API PHP — Guia do Higienizador (mesmo origin do SPA)
Options -Indexes

<IfModule mod_authz_core.c>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "config.php">
    Deny from all
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
